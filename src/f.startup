ip link set eth0 address 00:0f:00:00:00:00
ip link set eth1 address 00:0f:01:00:00:00
ip link set eth2 address 00:0f:02:00:00:00
ip link set eth3 address 00:0f:03:00:00:00

ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up

p4c /shared/transit.p4 -o /

simple_switch -i 0@eth0 -i 1@eth1 -i 2@eth2 -i 3@eth3 transit.json --log-file /shared/logs/f.log &

while [[ $(pgrep simple_switch) -eq 0 ]]; do sleep 1; done
until simple_switch_CLI <<< "help"; do sleep 1; done

simple_switch_CLI <<< $(cat commands.txt)