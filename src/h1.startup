
ip link set eth0 address 00:3a:00:00:00:00
ip link set eth0 up
ip link set dev eth0 mtu 1400
ethtool -K eth0 tx off


ip addr add 10.0.1.10/24 dev eth0
ip route add default via 10.0.1.1
ip neigh add 10.0.1.1 lladdr 00:00:00:00:00:0A dev eth0

# Wait until h3 (10.1.1.10) is listening on port 5201
echo "Waiting for h3 iperf3 server..."
while ! timeout 1 bash -c 'cat < /dev/null > /dev/tcp/10.1.1.10/5201' 2>/dev/null; do
    sleep 1
done
echo "Server is ready. Starting bandwidth test..."
iperf3 -c 10.1.1.10 -t 5 > /shared/logs/h1_test_results.log 2>&1