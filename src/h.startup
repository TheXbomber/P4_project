ip link set eth0 address 00:2a:00:00:00:00
ip link set eth1 address 00:2a:01:00:00:00
ip link set eth2 address 00:2a:02:00:00:00
ip link set eth3 address 00:2a:03:00:00:00

ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up

p4c /shared/transit.p4 -o /

simple_switch -i 0@eth0 -i 1@eth1 -i 2@eth2 -i 3@eth3 transit.json --log-file /shared/logs/h.log &

while [[ $(pgrep simple_switch) -eq 0 ]]; do sleep 1; done
until simple_switch_CLI <<< "help"; do sleep 1; done

simple_switch_CLI <<< $(cat commands.txt)

tcpdump -i eth0 -w /shared/pkt_captures/h_eth0.pcap -U & 
tcpdump -i eth1 -w /shared/pkt_captures/h_eth1.pcap -U & 
tcpdump -i eth2 -w /shared/pkt_captures/h_eth2.pcap -U & 
tcpdump -i eth3 -w /shared/pkt_captures/h_eth3.pcap -U &